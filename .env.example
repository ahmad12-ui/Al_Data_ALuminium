# ============================
# SERVER-ONLY (never exposed to the browser)
# ============================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/aldata

# Cloudinary (server-side upload/delete)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin authentication — a long random string, NOT a real password shared elsewhere.
# This is the single code entered on /admin/login. Never prefix with NEXT_PUBLIC_.
ADMIN_SECRET_CODE=change-this-secret
# Secret used to sign the admin session cookie (JWT). Generate with: openssl rand -hex 32
SESSION_SECRET=change-this-too-generate-a-long-random-string

# Email (Nodemailer via Gmail SMTP app password, or swap for another provider)
EMAIL_SERVICE=gmail
EMAIL_USER=usmanhafizusman416@gmail.com
EMAIL_PASSWORD=your-gmail-app-password
EMAIL_TO=usmanhafizusman416@gmail.com

# ============================
# PUBLIC (safe to expose to the browser — prefixed NEXT_PUBLIC_)
# ============================

NEXT_PUBLIC_SITE_URL=http://localhost:3000
